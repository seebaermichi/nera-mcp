{
    "name": "@nera-static/mcp",
    "version": "1.1.0",
    "description": "A local MCP server for Nera: lets an AI assistant create, edit, build, validate, preview and publish Nera static sites under one folder",
    "type": "module",
    "files": [
        ".claude-plugin/icon.png",
        ".claude-plugin/plugin.json",
        "bin",
        "docs",
        "skills",
        "src",
        "CHANGELOG.md"
    ],
    "scripts": {
        "lint": "eslint .",
        "test": "vitest",
        "prepack": "node scripts/fetch-docs.js && node scripts/sync-skill.js",
        "mcpb": "node scripts/fetch-docs.js && node scripts/build-mcpb.js",
        "skill": "node scripts/sync-skill.js",
        "version": "node scripts/sync-version.js && git add .claude-plugin/plugin.json"
    },
    "keywords": [
        "nera",
        "mcp",
        "model-context-protocol",
        "static-site-generator",
        "ai",
        "claude"
    ],
    "author": "Michael Becker",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/seebaermichi/nera-mcp.git"
    },
    "bugs": {
        "url": "https://github.com/seebaermichi/nera-mcp/issues"
    },
    "homepage": "https://github.com/seebaermichi/nera-mcp#readme",
    "engines": {
        "node": ">=22.12.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.32.2",
        "@nera-static/core": "^4.18.3",
        "@nera-static/nera": "^1.24.0",
        "@nera-static/validate": "^1.7.0",
        "yaml": "^2.9.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@anthropic-ai/mcpb": "^2.1.2",
        "eslint": "^10.15.0",
        "vitest": "^5.1.1"
    },
    "bin": {
        "nera-mcp": "bin/nera-mcp.js"
    },
    "mcpName": "io.github.seebaermichi/nera-mcp"
}
